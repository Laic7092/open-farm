; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="open-farm"
config/description="牧场物语风格农场经营模拟（2D 俯视角像素风）"
config/version="0.6"
run/main_scene="res://scenes/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
AppTheme="*res://src/autoload/app_theme.gd"
Database="*res://src/autoload/database.gd"
SaveManager="*res://src/autoload/save_manager.gd"
SceneRouter="*res://src/autoload/scene_router.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gdunit4]

settings/test/test_lookup_folder="tests"

[gui]

theme/custom="res://assets/themes/game_theme.tres"
theme/default_font_size=12

