[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/content.zh_CN.translation", "res://assets/i18n/content.en.translation", "res://assets/i18n/dialogue.zh_CN.translation", "res://assets/i18n/dialogue.en.translation", "res://assets/i18n/ui.zh_CN.translation", "res://assets/i18n/ui.en.translation")
locale/fallback="zh_CN"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"
2d_physics/layer_4="interactable"
2d_physics/layer_5="trigger"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
