<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0f1116">
<title>{{ title }} · open-farm wiki</title>
<link rel="stylesheet" href="app.css">
</head>
<body>
{% include "_sidebar.html.j2" %}
<div class="shell">
  <header class="topbar">
    {% if back %}<a class="iconbtn" href="{{ back_url }}" aria-label="返回">‹</a>{% endif %}
    <h1>{{ title }}</h1>
    <button class="iconbtn search-open" type="button" aria-label="搜索">⌕</button>
  </header>
  <main class="wrap">{% block content %}{% endblock %}</main>
</div>
{% include "_tabbar.html.j2" %}
<button id="totop" type="button" title="回到顶部">↑</button>
<div class="searchlayer" hidden>
  <div class="searchbar">
    <input id="q" placeholder="搜索名称 / id / 分类…" autocomplete="off">
    <button class="search-close" type="button">取消</button>
  </div>
  <div id="sres" class="sres"></div>
</div>
<script src="search-index.js"></script>
<script src="app.js"></script>
</body>
</html>
